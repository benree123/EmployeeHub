@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Sign In";
    var demo = Configuration.GetValue<bool>("Demo:Enabled");
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="mb-4">
            <h1 class="fw-bold mb-1">Sign in</h1>
            <p class="text-muted">Sign in to view and manage employee records.</p>
        </div>

        @if (demo)
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold">Just looking?</h2>
                    <p class="text-muted">Try every feature with fictional data. No password needed.</p>
                    <form asp-action="Demo" method="post">
                        <button type="submit" class="btn btn-primary w-100">Try the demo</button>
                    </form>
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label for="username" class="form-label fw-semibold">Username</label>
                        <input id="username" name="username" class="form-control" autocomplete="username" required />
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label fw-semibold">Password</label>
                        <input id="password" name="password" type="password" class="form-control" autocomplete="current-password" required />
                    </div>
                    <button type="submit" class="btn btn-dark w-100">Sign in</button>
                </form>
            </div>
        </div>
    </div>
</div>
