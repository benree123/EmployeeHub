@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Sign in";
}

<div class="sign-in">
    <h1>Sign in</h1>

    @if (Configuration.GetValue<bool>("Demo:Enabled"))
    {
        <div class="demo-offer">
            <p><strong>Just looking?</strong> Try every feature with fictional records. No password needed.</p>
            <form asp-action="Demo" method="post">
                <button type="submit" class="button button-main">Try the demo</button>
            </form>
        </div>
    }

    <form asp-action="Login" method="post" class="record-form">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <div asp-validation-summary="ModelOnly" class="form-error"></div>
        <div class="field-group">
            <label for="username">Username</label>
            <input id="username" name="username" class="field" autocomplete="username" required />
        </div>
        <div class="field-group">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" class="field" autocomplete="current-password" required />
        </div>
        <button type="submit" class="button button-quiet">Sign in</button>
    </form>
</div>
