@model HomeViewModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Overview";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var total = Math.Max(1, Model.EmployeeCount);
}

<div class="page-heading">
    <div>
        <h1>Employee records</h1>
        <p class="muted">Search the directory, keep details up to date, and control who can see salaries.</p>
    </div>
    <div class="button-row">
        @if (Configuration.GetValue<bool>("Demo:Enabled") && !signedIn)
        {
            <form asp-controller="Account" asp-action="Demo" method="post">
                <button type="submit" class="button button-main">Try the demo</button>
            </form>
            <a class="button button-quiet" asp-controller="Account" asp-action="Login">Sign in</a>
        }
        else if (signedIn)
        {
            <a class="button button-main" asp-controller="Employees" asp-action="Index">Open the directory</a>
        }
        else
        {
            <a class="button button-main" asp-controller="Account" asp-action="Login">Sign in</a>
        }
    </div>
</div>

<dl class="summary">
    <div><dt>Employees</dt><dd><strong>@Model.EmployeeCount</strong></dd></div>
    <div><dt>Departments</dt><dd><strong>@Model.DepartmentCount</strong></dd></div>
</dl>

<div class="overview-grid">
    <section aria-labelledby="workforce-title">
        <h2 id="workforce-title">Workforce by department</h2>
        @if (Model.Departments.Any())
        {
            <div class="grid-wrap">
                <table class="data-grid compact">
                    <thead>
                        <tr><th scope="col">Department</th><th scope="col" class="numeric">Employees</th><th scope="col" class="numeric">Share</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var department in Model.Departments)
                        {
                            <tr>
                                <td data-label="Department">@department.Name</td>
                                <td data-label="Employees" class="numeric">@department.Employees</td>
                                <td data-label="Share" class="numeric">@(department.Employees * 100 / total)%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="muted">No employee records yet.</p>
        }
    </section>

    <section aria-labelledby="recent-title">
        <h2 id="recent-title">Recently added</h2>
        @if (Model.Recent.Any())
        {
            <div class="grid-wrap">
                <table class="data-grid compact">
                    <thead>
                        <tr><th scope="col">Name</th><th scope="col">Position</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model.Recent)
                        {
                            <tr>
                                <td data-label="Name"><a asp-controller="Employees" asp-action="Details" asp-route-id="@employee.Id">@employee.FirstName @employee.LastName</a></td>
                                <td data-label="Position">@employee.Position</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (signedIn)
        {
            <p class="muted">No employee records yet.</p>
        }
        else
        {
            <p class="muted">Sign in to see recent employee records.</p>
        }
    </section>
</div>
