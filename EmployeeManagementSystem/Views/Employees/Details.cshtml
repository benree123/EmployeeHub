@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="mb-4">
            <h1 class="fw-bold mb-1">Employee Details</h1>
            <p class="text-muted">
                View employee information.
            </p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">

                <div class="row mb-4">
                    <div class="col-md-6">
                        <small class="text-muted">First Name</small>
                        <p class="fw-semibold mb-0">@Model.FirstName</p>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted">Last Name</small>
                        <p class="fw-semibold mb-0">@Model.LastName</p>
                    </div>
                </div>

                <div class="mb-4">
                    <small class="text-muted">Email</small>
                    <p class="fw-semibold mb-0">@Model.Email</p>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <small class="text-muted">Department</small>
                        <p class="fw-semibold mb-0">@Model.Department</p>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted">Position</small>
                        <p class="fw-semibold mb-0">@Model.Position</p>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <small class="text-muted">Salary</small>
                        <p class="fw-semibold mb-0">
                            @Model.Salary.ToString("C")
                        </p>
                    </div>

                    <div class="col-md-6">
                        <small class="text-muted">Hire Date</small>
                        <p class="fw-semibold mb-0">
                            @Model.HireDate.ToString("MMMM dd, yyyy")
                        </p>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                        Edit Employee
                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Back to Employees
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>