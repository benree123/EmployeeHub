@model Employee
@{
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName}";
}

<div class="narrow">
    <a class="back-link" asp-action="Index">Back to employees</a>
    <h1 class="visually-hidden">Employee details</h1>
    <partial name="_PersonnelFile" model="Model" />

    @if (User.CanEdit())
    {
        <div class="button-row file-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="button button-main">Edit employee</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="button button-text danger-link">Delete employee</a>
        </div>
    }
</div>
