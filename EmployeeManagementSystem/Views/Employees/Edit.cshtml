@model Employee
@{
    ViewData["Title"] = "Edit employee";
}

<div class="narrow">
    <a class="back-link" asp-action="Details" asp-route-id="@Model.Id">Back to employee</a>
    <h1>Edit employee</h1>

    <form asp-action="Edit" method="post" class="record-form">
        <input type="hidden" asp-for="Id" />
        <partial name="_EmployeeFields" model="Model" />
        <div class="button-row">
            <button type="submit" class="button button-main">Save changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="button button-text">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
