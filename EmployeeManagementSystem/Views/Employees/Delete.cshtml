@model Employee
@{
    ViewData["Title"] = "Delete employee";
}

<div class="narrow">
    <a class="back-link" asp-action="Details" asp-route-id="@Model.Id">Back to employee</a>
    <h1>Delete @Model.FirstName @Model.LastName?</h1>
    <p class="muted delete-note">This permanently removes the record and can't be undone.</p>
    <partial name="_EmployeeRecord" model="Model" />

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="button-row file-actions">
            <button type="submit" class="button button-danger">Delete employee</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="button button-text">Keep employee</a>
        </div>
    </form>
</div>
