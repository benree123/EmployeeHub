@model EmployeeListViewModel
@{
    ViewData["Title"] = "Employees";
    var canEdit = User.CanEdit();
    bool NextDescending(string key) => Model.Sort == key && !Model.Descending;
    string? SortState(string key) => Model.Sort != key ? null : Model.Descending ? "descending" : "ascending";
    string Arrow(string key) => Model.Sort != key ? "" : Model.Descending ? " ↓" : " ↑";
    var money = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="page-heading">
    <div>
        <h1>Employees</h1>
        <p class="muted">@Model.Total @(Model.Total == 1 ? "employee" : "employees")@(Model.Search != null ? $" matching “{Model.Search}”" : "")</p>
    </div>
    @if (canEdit)
    {
        <a asp-action="Create" class="button button-main">Add employee</a>
    }
</div>

<form asp-action="Index" method="get" class="search-bar" role="search">
    <label for="searchString" class="visually-hidden">Search employees</label>
    <input id="searchString" type="search" name="searchString" value="@Model.Search" class="field" placeholder="Name, email, department, or position" />
    <button type="submit" class="button button-quiet">Search</button>
    @if (Model.Search != null)
    {
        <a asp-action="Index" class="button button-text">Clear</a>
    }
</form>

@if (Model.Items.Any())
{
    <div class="grid-wrap">
        <table class="data-grid">
            <thead>
                <tr>
                    <th scope="col" class="numeric" aria-sort="@SortState("id")"><a asp-action="Index" asp-route-searchString="@Model.Search" asp-route-sort="id" asp-route-desc="@(Model.Sort == "id" ? !Model.Descending : true)">Employee ID@(Arrow("id"))</a></th>
                    <th scope="col" aria-sort="@SortState("name")"><a asp-action="Index" asp-route-searchString="@Model.Search" asp-route-sort="name" asp-route-desc="@NextDescending("name")">Name@(Arrow("name"))</a></th>
                    <th scope="col">Email</th>
                    <th scope="col" aria-sort="@SortState("department")"><a asp-action="Index" asp-route-searchString="@Model.Search" asp-route-sort="department" asp-route-desc="@NextDescending("department")">Department@(Arrow("department"))</a></th>
                    <th scope="col" aria-sort="@SortState("position")"><a asp-action="Index" asp-route-searchString="@Model.Search" asp-route-sort="position" asp-route-desc="@NextDescending("position")">Position@(Arrow("position"))</a></th>
                    @if (canEdit)
                    {
                        <th scope="col" class="numeric" aria-sort="@SortState("salary")"><a asp-action="Index" asp-route-searchString="@Model.Search" asp-route-sort="salary" asp-route-desc="@NextDescending("salary")">Salary@(Arrow("salary"))</a></th>
                    }
                    <th scope="col" aria-sort="@SortState("hired")"><a asp-action="Index" asp-route-searchString="@Model.Search" asp-route-sort="hired" asp-route-desc="@NextDescending("hired")">Hire date@(Arrow("hired"))</a></th>
                    @if (canEdit)
                    {
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td data-label="Employee ID" class="numeric id-cell">@item.Id.ToString("D4")</td>
                        <td data-label="Name" class="name-cell"><a class="person-name" asp-action="Details" asp-route-id="@item.Id">@item.LastName, @item.FirstName</a></td>
                        <td data-label="Email" class="email-cell">@item.Email</td>
                        <td data-label="Department">@item.Department</td>
                        <td data-label="Position">@item.Position</td>
                        @if (canEdit)
                        {
                            <td data-label="Salary" class="numeric salary-cell">@item.Salary.ToString("$#,##0.00", money)</td>
                        }
                        <td data-label="Hire date" class="hire-date">@item.HireDate.ToString("MMM d, yyyy", money)</td>
                        @if (canEdit)
                        {
                            <td class="row-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" aria-label="Edit @item.FirstName @item.LastName">Edit</a>
                                <a class="danger-link" asp-action="Delete" asp-route-id="@item.Id" aria-label="Delete @item.FirstName @item.LastName">Delete</a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav class="pager" aria-label="Pages">
        <span class="muted">Page @Model.Page of @Model.TotalPages</span>
        <div class="button-row">
            @if (Model.Page > 1)
            {
                <a class="button button-quiet" asp-action="Index" asp-route-searchString="@Model.Search" asp-route-sort="@Model.Sort" asp-route-desc="@Model.Descending" asp-route-page="@(Model.Page - 1)">Previous</a>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <a class="button button-quiet" asp-action="Index" asp-route-searchString="@Model.Search" asp-route-sort="@Model.Sort" asp-route-desc="@Model.Descending" asp-route-page="@(Model.Page + 1)">Next</a>
            }
        </div>
    </nav>
}
else
{
    <div class="empty-state">
        @if (Model.Search != null)
        {
            <h2>No employees match your search</h2>
            <p class="muted">Check the spelling, or search for a department or position instead.</p>
            <a asp-action="Index" class="button button-quiet">Clear search</a>
        }
        else
        {
            <h2>No employees yet</h2>
            @if (canEdit)
            {
                <p class="muted">Add your first employee to start the directory.</p>
                <a asp-action="Create" class="button button-main">Add employee</a>
            }
            else
            {
                <p class="muted">Employees will appear here after an editor adds them.</p>
            }
        }
    </div>
}
