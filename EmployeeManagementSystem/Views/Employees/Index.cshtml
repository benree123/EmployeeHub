@using EmployeeManagementSystem.Security
@model EmployeeManagementSystem.Models.EmployeeListViewModel

@{
    ViewData["Title"] = "Employees";
    var canEdit = User.CanEdit();
    bool NextDescending(string key) => Model.Sort == key && !Model.Descending;
    string Arrow(string key) => Model.Sort != key ? "" : Model.Descending ? " ↓" : " ↑";
}

<div class="employees-page">

    <!-- PAGE HEADER -->
    <div class="employees-header">

        <div>
            <span class="page-label">EMPLOYEE DIRECTORY</span>

            <h1>Employees</h1>

            <p>
                View, search, and manage employee records.
            </p>
        </div>

        @if (canEdit)
        {
            <div>
                <a asp-action="Create"
                   class="btn btn-primary">
                    + Add Employee
                </a>
            </div>
        }

    </div>


    <!-- SEARCH -->
    <div class="employee-search-card">

        <form asp-action="Index"
              method="get"
              class="employee-search-form">

            <div class="search-input-wrapper">

                <span class="search-icon">⌕</span>

                <input type="text"
                       name="searchString"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="Search by name, email, department or position..." />

            </div>

            <button type="submit"
                    class="btn btn-dark">
                Search
            </button>

            @if (Model.Search != null)
            {
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Clear
                </a>
            }

        </form>

    </div>


    @if (Model.Items.Any())
    {
        <!-- EMPLOYEE TABLE -->
        <div class="employee-table-card">

            <div class="table-responsive">

                <table class="table employee-table">

                    <thead>
                        <tr>
                            <th><a class="text-reset text-decoration-none" asp-action="Index" asp-route-searchString="@Model.Search" asp-route-sort="name" asp-route-desc="@NextDescending("name")">Employee@Arrow("name")</a></th>
                            <th>Email</th>
                            <th><a class="text-reset text-decoration-none" asp-action="Index" asp-route-searchString="@Model.Search" asp-route-sort="department" asp-route-desc="@NextDescending("department")">Department@Arrow("department")</a></th>
                            <th><a class="text-reset text-decoration-none" asp-action="Index" asp-route-searchString="@Model.Search" asp-route-sort="position" asp-route-desc="@NextDescending("position")">Position@Arrow("position")</a></th>
                            @if (canEdit)
                            {
                                <th><a class="text-reset text-decoration-none" asp-action="Index" asp-route-searchString="@Model.Search" asp-route-sort="salary" asp-route-desc="@NextDescending("salary")">Salary@Arrow("salary")</a></th>
                            }
                            <th><a class="text-reset text-decoration-none" asp-action="Index" asp-route-searchString="@Model.Search" asp-route-sort="hired" asp-route-desc="@NextDescending("hired")">Hire Date@Arrow("hired")</a></th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            var initials =
                            $"{item.FirstName?.FirstOrDefault()}{item.LastName?.FirstOrDefault()}";

                            <tr>

                                <!-- EMPLOYEE -->
                                <td>
                                    <div class="employee-name-cell">

                                        <div class="employee-table-avatar">
                                            @initials
                                        </div>

                                        <div>
                                            <strong>
                                                @item.FirstName @item.LastName
                                            </strong>

                                            <small>
                                                Employee #@item.Id
                                            </small>
                                        </div>

                                    </div>
                                </td>


                                <!-- EMAIL -->
                                <td>
                                    @item.Email
                                </td>


                                <!-- DEPARTMENT -->
                                <td>
                                    <span class="department-badge">
                                        @item.Department
                                    </span>
                                </td>


                                <!-- POSITION -->
                                <td>
                                    @item.Position
                                </td>


                                <!-- SALARY -->
                                @if (canEdit)
                                {
                                    <td class="salary-cell">
                                        @item.Salary.ToString("C")
                                    </td>
                                }


                                <!-- HIRE DATE -->
                                <td>
                                    @item.HireDate.ToString("MMM dd, yyyy")
                                </td>


                                <!-- ACTIONS -->
                                <td>

                                    <div class="employee-actions">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            View
                                        </a>

                                        @if (canEdit)
                                        {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="d-flex justify-content-between align-items-center p-3">
                <span class="text-muted">@Model.Total employee(s) · Page @Model.Page of @Model.TotalPages</span>
                <div class="d-flex gap-2">
                    @if (Model.Page > 1)
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-searchString="@Model.Search" asp-route-sort="@Model.Sort" asp-route-desc="@Model.Descending" asp-route-page="@(Model.Page - 1)">Previous</a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-searchString="@Model.Search" asp-route-sort="@Model.Sort" asp-route-desc="@Model.Descending" asp-route-page="@(Model.Page + 1)">Next</a>
                    }
                </div>
            </div>

        </div>
    }
    else
    {
        <!-- EMPTY STATE -->
        <div class="employee-empty-state">

            <div class="empty-state-icon">
                👥
            </div>

            <h3>No employees found</h3>

            @if (Model.Search != null)
            {
                <p>
                    No employees match your search.
                    Try another search or clear the current search.
                </p>

                <a asp-action="Index"
                   class="btn btn-outline-secondary me-2">
                    Clear Search
                </a>
            }
            else
            {
                <p>
                    Your employee directory is currently empty.
                </p>
            }

            @if (canEdit)
            {
                <a asp-action="Create"
                   class="btn btn-primary">
                    + Add Employee
                </a>
            }

        </div>
    }

</div>