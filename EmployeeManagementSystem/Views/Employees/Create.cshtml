@model Employee
@{
    ViewData["Title"] = "Add employee";
}

<div class="narrow">
    <a class="back-link" asp-action="Index">Back to employees</a>
    <h1>Add employee</h1>

    <form asp-action="Create" method="post" class="record-form">
        <partial name="_EmployeeFields" model="Model" />
        <div class="button-row">
            <button type="submit" class="button button-main">Add employee</button>
            <a asp-action="Index" class="button button-text">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
