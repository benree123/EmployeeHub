@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var onHome = controller == "Home";
    var onAdd = controller == "Employees" && action == "Create";
    var onDirectory = controller == "Employees" && !onAdd;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#12372f" />
    <title>@ViewData["Title"] | EmployeeHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="shell">
        <header class="sidebar">
            <div class="sidebar-top">
                <a class="brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true"></span>
                    EmployeeHub
                </a>
                <button class="menu-button" type="button" data-bs-toggle="collapse" data-bs-target="#navigation"
                        aria-controls="navigation" aria-expanded="false">
                    Menu
                </button>
            </div>

            <div class="collapse sidebar-collapse" id="navigation">
                <nav aria-label="Main">
                    <a class="nav-item" aria-current="@(onHome ? "page" : null)" asp-controller="Home" asp-action="Index">Overview</a>
                    <a class="nav-item" aria-current="@(onDirectory ? "page" : null)" asp-controller="Employees" asp-action="Index">Employees</a>
                    @if (User.CanEdit())
                    {
                        <a class="nav-item" aria-current="@(onAdd ? "page" : null)" asp-controller="Employees" asp-action="Create">Add employee</a>
                    }
                </nav>

                <div class="account">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="account-name">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="account-action">Sign out</button>
                        </form>
                    }
                    else
                    {
                        <a class="account-action" asp-controller="Account" asp-action="Login">Sign in</a>
                    }
                </div>
            </div>
        </header>

        <div class="workspace">
            <main id="main" class="page">
                @if (User.IsInRole(Roles.DemoGuest))
                {
                    <p class="demo-banner" role="status">
                        <strong>Shared demo.</strong> Records are fictional and reset every 30 minutes, and other visitors can see your changes. Please don't enter real information.
                    </p>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
