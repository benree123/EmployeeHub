@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="empty-state">
    <h1>This page couldn't load</h1>
    <p class="muted">Try again, or go back to the employee directory.</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Employees" asp-action="Index" class="button button-quiet">Go to employees</a>
</div>
